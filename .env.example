# Hanya rahasia infrastruktur yang disimpan di sini.
# Pengaturan Odoo (URL, API key, jadwal) diisi lewat halaman Pengaturan di aplikasi.
# Buat file .env asli dengan:  ./setup.sh
POSTGRES_USER=odoobi
POSTGRES_PASSWORD=GANTI
POSTGRES_DB=odoo_bi
MASTER_KEY=GANTI            # kunci Fernet; simpan di password manager
SECRET_KEY=GANTI            # penanda tangan cookie sesi
DOMAIN=localhost            # isi nama domain agar HTTPS Let's Encrypt otomatis
COOKIE_SECURE=true          # set false hanya bila diuji tanpa HTTPS
# ADMIN_INITIAL_PASSWORD=   # opsional; jika kosong, dibuat acak dan tampil di log
